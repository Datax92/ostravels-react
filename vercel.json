{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/contact-2",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/contact-2/(.*)",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/branches/peshawar",
      "destination": "/branches/islamabad-blue-area/",
      "permanent": true
    },
    {
      "source": "/branches/peshawar/(.*)",
      "destination": "/branches/islamabad-blue-area/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/ticketing",
      "destination": "/air-ticketing/",
      "permanent": true
    },
    {
      "source": "/insurance",
      "destination": "/travel-insurance/",
      "permanent": true
    },
    {
      "source": "/best-travel-agent-for-:slug",
      "destination": "/best-travel-agency-for-:slug/",
      "permanent": true
    },
    {
      "source": "/(sitemap_index|sitemap-index|wp-sitemap|page-sitemap|post-sitemap)\\.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/)(?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
